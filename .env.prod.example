# Application-owned production secret. The operator creates `.env.prod` from
# this example and loads it only when the deployment guide says to do so.
# Provider credentials and database URLs do not belong here; shipctl supplies
# them from its own provider environment.

# Generate one URL-safe 32-byte key with:
# python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("="))'
ODOO_MCP_ENCRYPTION_KEYS=1:replace-with-url-safe-base64-32-byte-key
