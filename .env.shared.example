# Shared Hosted operator configuration. Supply real values through a secret
# store or process environment; never commit a populated copy.

# Canonical public authorization-server origin. Standard OAuth routes are
# served below this origin.
ODOO_MCP_SHARED_ISSUER_URL=https://mcp.example.com

# Exact protected-resource identifier and public MCP route.
ODOO_MCP_SHARED_PUBLIC_MCP_URL=https://mcp.example.com/mcp

# Shared Hosted supports one writable process and a durable local SQLite volume.
ODOO_MCP_SHARED_STORAGE_KIND=local

# Active key and comma-separated version:URL-safe-base64 entries. Each decoded
# key must contain exactly 32 random bytes. Retain old versions during rotation.
ODOO_MCP_ACTIVE_KEY_VERSION=1
ODOO_MCP_ENCRYPTION_KEYS=1:replace-with-url-safe-base64-32-byte-key
