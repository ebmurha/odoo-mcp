# Local real-Odoo development
#
# 1. Copy this file without committing the copy:
#      Copy-Item .env.example .env.local
# 2. Replace every placeholder below.
# 3. Use a dedicated non-production Odoo technical user and API key.
# 4. Keep .env.local private. The application must never log these values.

# Base URL only; omit a trailing slash.
ODOO_MCP_ODOO_URL=https://odoo.example.com

# Odoo database name and technical-user login.
ODOO_MCP_ODOO_DATABASE=replace-with-test-database
ODOO_MCP_ODOO_USERNAME=mcp-test-user@example.com

# Generate this in Odoo for the technical user. It replaces the password.
ODOO_MCP_ODOO_API_KEY=replace-with-odoo-api-key

# Comma-separated Odoo company IDs the local connection may access.
ODOO_MCP_ALLOWED_COMPANY_IDS=1

# Used when a local discovery call or test does not supply company_id.
# It must also appear in ODOO_MCP_ALLOWED_COMPANY_IDS.
ODOO_MCP_DEFAULT_COMPANY_ID=1
